memory_initialization_radix=16;
memory_initialization_vector=
// ARCHIVO DE PRUEBA PARA HAZARDS EN PIPELINE MIPS
// Este archivo demuestra casos específicos de riesgos de datos y load-use hazards

// === CASO 1: DATA HAZARD (RAW - Read After Write) ===
// Dependencia directa: instrucción siguiente necesita resultado de la anterior

20230003,  // addi $3, $1, 3         // $3 = $1 + 3  = 0 + 3 = 3
20640008,  // addi $4, $3, 8         // $4 = $3 + 8  = 3 + 8 = 11 (HAZARD: necesita $3 de la línea anterior)
2085000B,  // addi $5, $4, 11        // $5 = $4 + 11 = 11 + 11 = 22 (HAZARD: necesita $4 de la línea anterior)

// === CASO 2: LOAD-USE HAZARD ===
// El resultado de un LOAD no puede ser forwarded al EX stage inmediatamente
// porque el dato viene del MEM stage, causando un stall obligatorio

AC030014,  // sw $3, 20($0)         // Guardar $3 en memoria[20] = 3
8C060014,  // lw $6, 20($0)         // $6 = mem[20] = 3 (LOAD)
00C62020,  // add $4, $6, $6        // $4 = $6 + $6 = 3 + 3 = 6 (LOAD-USE HAZARD!)

// === CASO 3: LOAD-BRANCH HAZARD (CRÍTICO) ===
// Branch inmediatamente después de LOAD - el forwarding ID debe estar correcto

AC030018,  // sw $3, 24($0)         // Guardar $3 en memoria[24] = 3
20070003,  // addi $7, $0, 3         // $7 = 3 (valor para comparar)
8C080018,  // lw $8, 24($0)         // $8 = mem[24] = 3 (LOAD)
11070002,  // beq $8, $7, +2        // if ($8 == $7) salta 2 instrucciones (LOAD-BRANCH HAZARD!)
20090001,  // addi $9, $0, 1         // $9 = 1 (NO debe ejecutarse si branch funciona)
2009000A,  // addi $9, $0, 10        // $9 = 10 (NO debe ejecutarse si branch funciona)
200A00FF,  // addi $10, $0, 255      // $10 = 255 (SÍ debe ejecutarse - target del branch)

FFFFFFFF;  // HALT
